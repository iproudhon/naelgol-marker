<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Only the keys Xcode's Info.plist GENERATOR refuses to emit. Everything else
  comes from INFOPLIST_KEY_* build settings and is merged on top of this file.

  Both of these fail SILENTLY if missing, which is why they are pinned here:
    UIBackgroundModes    - without `audio` + `location` the round stops the
                           instant the screen locks. That is every round, since
                           the phone lives in a pocket.
    UIFileSharingEnabled - the entire device->Mac transfer story. Without it the
                           session folders are invisible to Finder and Files.
-->
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
